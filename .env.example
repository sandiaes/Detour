# Copy to .env for local use. .env is ignored by git.
# NEVER put real secrets in this file or anywhere in the repository. In production the secrets
# are set only in the hosting providers' settings (Render, Supabase, GitHub): docs/deployment.md.

# --- Backend (services/api) -----------------------------------------------------------------
# local | test | production
DETOUR_ENVIRONMENT=local
DETOUR_LOG_LEVEL=INFO
# PostgreSQL URL. Left empty, the API runs without a database. Local Docker Compose sets it
# itself; for Supabase use the session-pooler string (docs/deployment.md).
DETOUR_DATABASE_URL=
# Signs anonymous installation tokens. Empty is accepted outside production (a fixed development
# value is used). Production needs at least 32 random characters, set on Render only.
DETOUR_TOKEN_SECRET=
# Served to the app by GET /v1/config. Defaults are OpenFreeMap; change here, not in the app.
# DETOUR_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# DETOUR_CONFIG_VERSION=1

# Photon (komoot's public geocoder), the only external search provider, called by the backend only
# when a search asks for it and the local data has no match (ADR 012). The budget is our own.
# DETOUR_PHOTON_ENABLED=true
# DETOUR_PHOTON_DAILY_BUDGET=300
# DETOUR_PHOTON_USER_AGENT=Detour-backend/0.2 (+https://github.com/sandiaes/Detour)

# FOSSGIS Valhalla (travel times), called by the backend only, never by tests or the app (ADR 004,
# ADR 013). The rate (1 per second, burst 10) cannot be set higher. The budget, timeout and cache cap
# are our own limits.
# DETOUR_ROUTING_ENABLED=true
# DETOUR_ROUTING_DAILY_BUDGET=1500
# DETOUR_ROUTING_TIMEOUT_SECONDS=10
# DETOUR_ROUTING_MAX_WAIT_SECONDS=5
# DETOUR_ROUTING_CACHE_MAX_ROWS=100000
# /route without turn-by-turn maneuvers (smaller answers; checked by hand, ADR 013). On by default.
# DETOUR_ROUTING_SLIM_ROUTE_REQUESTS=true

# --- Import commands (python -m detour_api.importer ...) ----------------------------------------
# Target: the Supabase SESSION pooler string, port 5432 (never 6543). In GitHub Actions this is the
# repository secret DETOUR_IMPORT_DATABASE_URL. Staging: a throwaway PostGIS the import may wipe.
# DETOUR_IMPORT_DATABASE_URL=
# DETOUR_STAGING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staging

# --- Docker Compose (infrastructure/docker-compose.yml) ----------------------------------------
# Throwaway credentials for the local database only (bound to 127.0.0.1).
POSTGRES_USER=detour
POSTGRES_PASSWORD=detour-local-only
POSTGRES_DB=detour
# DB_PORT=5432
# API_PORT=8000

# --- Tests ---------------------------------------------------------------------------------------
# A PostgreSQL server (any database name; tests create and drop their own scratch databases).
# CI sets both of these. Without the first, the database tests are skipped locally.
# DETOUR_TEST_DATABASE_URL=postgresql://detour:detour-local-only@127.0.0.1:5432/detour
# DETOUR_REQUIRE_DB_TESTS=1

# --- Mobile build (apps/mobile) ------------------------------------------------------------------
# The backend's base URL, inlined into the app when the APK is built. It is public, not a secret.
# In GitHub Actions it comes from the workflow input api_url or the repository variable
# DETOUR_API_URL.
EXPO_PUBLIC_DETOUR_API_URL=
