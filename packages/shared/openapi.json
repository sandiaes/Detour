{
  "openapi": "3.1.0",
  "info": {
    "title": "Detour API",
    "summary": "Backend for the Detour travel planner (Phase 1 foundation).",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up. Does not touch the database.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: the database answers and the geo and app schemas exist.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/config": {
      "get": {
        "tags": [
          "config"
        ],
        "summary": "Client configuration: map style URL and attribution lines.",
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfig"
                }
              }
            }
          }
        }
      }
    },
    "/v1/installations": {
      "post": {
        "tags": [
          "installations"
        ],
        "summary": "Register an anonymous installation and receive its bearer token.",
        "operationId": "register_installation",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationRegistration"
                }
              }
            }
          }
        }
      }
    },
    "/v1/installations/me": {
      "get": {
        "tags": [
          "installations"
        ],
        "summary": "Token check: returns the installation the bearer token belongs to.",
        "operationId": "current_installation",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationInfo"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AttributionLine": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "text",
          "url"
        ],
        "title": "AttributionLine"
      },
      "ClientConfig": {
        "properties": {
          "config_version": {
            "type": "string",
            "title": "Config Version"
          },
          "map": {
            "$ref": "#/components/schemas/MapConfig"
          }
        },
        "type": "object",
        "required": [
          "config_version",
          "map"
        ],
        "title": "ClientConfig"
      },
      "DatabaseStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable",
              "not_configured"
            ],
            "title": "Status"
          },
          "schemas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Schemas",
            "description": "Of 'app' and 'geo', those present"
          },
          "postgis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgis",
            "description": "PostGIS version if the extension is enabled"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DatabaseStatus"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "detour-api",
            "title": "Service",
            "default": "detour-api"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "release": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release",
            "description": "Commit identifier of the deployed build"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "InstallationInfo": {
        "properties": {
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          }
        },
        "type": "object",
        "required": [
          "installation_id"
        ],
        "title": "InstallationInfo"
      },
      "InstallationRegistration": {
        "properties": {
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "Bearer token. Shown once; keep it in secure storage."
          }
        },
        "type": "object",
        "required": [
          "installation_id",
          "token"
        ],
        "title": "InstallationRegistration"
      },
      "MapConfig": {
        "properties": {
          "style_url": {
            "type": "string",
            "title": "Style Url"
          },
          "attribution": {
            "items": {
              "$ref": "#/components/schemas/AttributionLine"
            },
            "type": "array",
            "title": "Attribution"
          }
        },
        "type": "object",
        "required": [
          "style_url",
          "attribution"
        ],
        "title": "MapConfig"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token from POST /v1/installations",
        "scheme": "bearer"
      }
    }
  }
}
