{
  "name": "@detour/shared",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Typed API client generated from the backend's OpenAPI contract (openapi.json).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts && prettier --write src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
